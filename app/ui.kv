                    id: time_field
        
        
                    MDTextFieldHintText:
        
                        text: "Time (14:30 or 02:30 PM)"
        
        
                MDLabel:
        
                    id: status_label
        
                    text: "Status: Not selected"
        
                    halign: "center"
        
                    adaptive_height: True
        
                    font_size: "18sp"
        
        
                MDBoxLayout:
        
                    orientation: "horizontal"
        
                    spacing: "15dp"
        
                    adaptive_height: True
        
                    pos_hint: {"center_x": 0.5}
        
        
                    MDButton:
        
                        style: "filled"
        
                        on_release:
        
                            root.set_status("Present")
        
        
                        MDButtonText:
        
                            text: "Present"
        
        
                    MDButton:
        
                        style: "outlined"
        
                        on_release:
        
                            root.set_status("Absent")
        
        
                        MDButtonText:
        
                            text: "Absent"
        
        
                MDLabel:
        
                    id: error_label
        
                    text: ""
        
                    halign: "center"
        
                    adaptive_height: True
        
                    theme_text_color: "Error"
        
        
                MDButton:
        
                    style: "filled"
        
                    pos_hint: {"center_x": 0.5}
        
                    on_release:
        
                        root.save_changes()
        
        
                    MDButtonText:
        
                        text: "Save Changes"
        
        
                MDButton:
        
                    style: "text"
        
                    pos_hint: {"center_x": 0.5}
        
                    on_release:
        
                        root.go_back()
        
        
                    MDButtonText:
        
                        text: "Back"
        
        
        
<MonthlyAttendanceScreen>:
    md_bg_color: self.theme_cls.backgroundColor

    MDBoxLayout:
        orientation: "vertical"

        # Header
        MDBoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: "56dp"
            padding: "5dp"
            spacing: "5dp"

            MDIconButton:
                icon: "arrow-left"
                on_release: root.go_back()

            MDLabel:
                text: "Monthly Attendance"
                font_size: "20sp"
                bold: True
                valign: "center"

            Widget:

            MDButton:
                style: "text"
                on_release: root.previous_month()

                MDButtonText:
                    text: "PREV"

            MDButton:
                style: "text"
                on_release: root.next_month()

                MDButtonText:
                    text: "NEXT"

        # Scrollable calendar area
        ScrollView:

            MDBoxLayout:
                orientation: "vertical"
                spacing: "15dp"
                padding: "20dp"
                size_hint_y: None
                height: self.minimum_height

                # Month title
                MDLabel:
                    id: month_title
                    text: "September 2026"
                    halign: "center"
                    font_size: "24sp"
                    bold: True
                    size_hint_y: None
                    height: "40dp"

                # Weekday names
                MDGridLayout:
                    cols: 7
                    spacing: "5dp"
                    size_hint_y: None
                    height: "35dp"

                    MDLabel:
                        text: "MON"
                        halign: "center"
                        valign: "center"
                        bold: True

                    MDLabel:
                        text: "TUE"
                        halign: "center"
                        valign: "center"
                        bold: True

                    MDLabel:
                        text: "WED"
                        halign: "center"
                        valign: "center"
                        bold: True

                    MDLabel:
                        text: "THU"
                        halign: "center"
                        valign: "center"
                        bold: True

                    MDLabel:
                        text: "FRI"
                        halign: "center"
                        valign: "center"
                        bold: True

                    MDLabel:
                        text: "SAT"
                        halign: "center"
                        valign: "center"
                        bold: True

                    MDLabel:
                        text: "SUN"
                        halign: "center"
                        valign: "center"
                        bold: True

                # Calendar dates
                MDGridLayout:
                    id: calendar_grid
                    cols: 7
                    spacing: "5dp"
                    padding: "0dp"
                    size_hint_y: None
                    height: self.minimum_height
                    row_default_height: "70dp"
                    row_force_default: True